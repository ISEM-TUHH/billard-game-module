        "longest_break": 0,
        "time": 600,
        "scoring_information": "1,000 \u00d7 (ln W \u2212 ln own) \u00f7 (ln W \u2212 ln B)",
        "score_aggregation": [
            {
                "$set": {
                    "_own": {
                        "$min": "$precision.distance"
                    }
                }
            },
            {
                "$lookup": {
                    "from": "KP2",
                    "let": {
                        "a": "$attestation",
                        "s": "$semester",
                        "c": "$_config_slot"
                    },
                    "pipeline": [
                        {
                            "$match": {
                                "$expr": {
                                    "$and": [
                                        {
                                            "$eq": [
                                                "$attestation",
                                                "$$a"
                                            ]
                                        },
                                        {
                                            "$eq": [
                                                "$semester",
                                                "$$s"
                                            ]
                                        },
                                        {
                                            "$eq": [
                                                "$_config_slot",
                                                "$$c"
                                            ]
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "$project": {
                                "_own": {
                                    "$min": "$precision.distance"
                                }
                            }
                        },
                        {
                            "$group": {
                                "_id": null,
                                "W": {
                                    "$max": "$_own"
                                },
                                "B": {
                                    "$min": "$_own"
                                }
                            }
                        }
                    ],
                    "as": "_run"
                }
            },
            {
                "$set": {
                    "_W": {
                        "$arrayElemAt": [
                            "$_run.W",
                            0
                        ]
                    },
                    "_B": {
                        "$arrayElemAt": [
                            "$_run.B",
                            0
                        ]
                    }
                }
            },
            {
                "$project": {
                    "score": {
                        "$cond": [
                            {
                                "$or": [
                                    {
                                        "$eq": [
                                            "$_W",
                                            "$_B"
                                        ]
                                    },
                                    {
                                        "$eq": [
                                            "$_own",
                                            "$_B"
                                        ]
                                    }
                                ]
                            },
                            1000,
                            {
                                "$cond": [
                                    {
                                        "$or": [
                                            {
                                                "$eq": [
                                                    "$_B",
                                                    0
                                                ]
                                            },
                                            {
                                                "$eq": [
                                                    "$_own",
                                                    0
                                                ]
                                            }
                                        ]
                                    },
                                    0,
                                    {
                                        "$multiply": [
                                            1000,
                                            {
                                                "$divide": [
                                                    {
                                                        "$subtract": [
                                                            {
                                                                "$log": [
                                                                    "$_W",
                                                                    10
                                                                ]
                                                            },
                                                            {
                                                                "$log": [
                                                                    "$_own",
                                                                    10
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "$subtract": [
                                                            {
                                                                "$log": [
                                                                    "$_W",
                                                                    10
                                                                ]
                                                            },
                                                            {
                                                                "$log": [
                                                                    "$_B",
                                                                    10
                                                                ]
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        ]
    },
