{
    "precision": 3,
    "distance": 3,
    "break": 1,
    "longest_break": 0,
    "time": 1800,
    "title": "KP2 Final Competition",
    "scoring_information": "The score consists of the longest distance minus 3x the best precision shot. Optional bonus points can be given from earlier attestations.",
    "score_aggregation": [
        {
            "$project": {
                "score": {
                    "$subtract": [
                        {
                            "$max": "$distance.distance"
                        },
                        {
                            "$multiply": [
                                {
                                    "$min": "$precision.distance"
                                },
                                3
                            ]
                        }
                    ]
                }
            }
        }
    ]
}